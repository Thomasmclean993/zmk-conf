#define ZMK_POINTING_DEFAULT_MOVE_VAL 1000 // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 12   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <0>;      // 0
    time-to-max-speed-ms = <300>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    // 上下滚动编码器行为

    scroll_vertical_encoder: scroll_vertical_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    // 左右滚动编码器行为

    scroll_horizontal_encoder: scroll_horizontal_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

        tap-ms = <100>;
    };

    spc_2shift_Halt: spc_2shift_alt {
        compatible = "zmk,behavior-tap-dance";
        label = "Space to 2t:underscore or h:alt";
        #binding-cells = <0>;
        bindings = <&mt LEFT_ALT SPACE>, <&kp UNDER>;
    };

    period_Hcomma_to_colon: period_Hcomma_to_colon {
        compatible = "zmk,behavior-tap-dance";
        label = "PERIOD_HCOMMA_TO_COLON";
        #binding-cells = <0>;
        bindings = <&mt COMMA PERIOD>, <&kp COLON>;
    };

    enter_2dash_Halt: enter_2dash_Halt {
        compatible = "zmk,behavior-tap-dance";
        label = "ENTER_2DASH_HALT";
        #binding-cells = <0>;
        bindings = <&mt RIGHT_ALT ENTER>, <&kp MINUS>;
    };

    gui_rclk: gui_rclk {
        compatible = "zmk,behavior-tap-dance";
        label = "GUI_RCLK";
        #binding-cells = <0>;
        bindings = <&kp RIGHT_GUI>, <&mkp RCLK>;
    };

    double_Hsing_equal: double_Hsing_equal {
        compatible = "zmk,behavior-tap-dance";
        label = "DOUBLE_HSING_EQUAL";
        #binding-cells = <0>;
        bindings = <&mt EQUAL SINGLE_QUOTE>, <&kp DOUBLE_QUOTES>;
    };

    Tword_Hshift_2Lock: Tword_Hshift_2Lock {
        compatible = "zmk,behavior-tap-dance";
        label = "TWORD_HSHIFT_2LOCK";
        #binding-cells = <0>;
        bindings = <&mt LEFT_SHIFT CLCK>, <&caps_word>;
    };

    behaviors {
    };

    combos {
        compatible = "zmk,combos";

        Left_RCLK {
            bindings = <&mkp RCLK>;
            key-positions = <26 27>;
        };

        Left_LCLK {
            bindings = <&mkp LCLK>;
            key-positions = <28 29>;
        };

        Right_RCLK {
            bindings = <&mkp RCLK>;
            key-positions = <32 33>;
        };

        Right_LCLK {
            bindings = <&mkp LCLK>;
            key-positions = <31 30>;
        };

        Right_Enter {
            bindings = <&kp ENTER>;
            key-positions = <31 32>;
        };

        Left_enter {
            bindings = <&kp ENTER>;
            key-positions = <27 28>;
        };

        Left_Shift {
            bindings = <&kp LEFT_SHIFT>;
            key-positions = <40 41>;
        };

        Right_Shift {
            bindings = <&kp LEFT_SHIFT>;
            key-positions = <43 42>;
        };

        Cap_Word {
            bindings = <&caps_word>;
            key-positions = <40 39>;
        };

        Cap_Lock {
            bindings = <&kp CAPS>;
            key-positions = <43 44>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        QWERTY {
            bindings = <
&trans  &trans  &lt 1 DEL            &kp Q          &kp A             &kp Z             &kp P      &mt LESS_THAN LEFT_PARENTHESIS  &mt GREATER_THAN RIGHT_PARENTHESIS  &kp BACKSPACE        &trans  &trans
&trans  &trans  &kp W                &kp E          &kp R             &lt 3 T           &lt 3 Y    &kp U                           &kp I                               &kp O                &trans  &trans
&trans  &trans  &kp S                &kp D          &kp F             &lt 4 G           &lt 4 H    &kp J                           &kp K                               &kp L                &trans  &trans
&trans  &trans  &kp X                &mt LG(C) C    &mt LG(V) V       &kp B             &kp N      &kp M                           &period_Hcomma_to_colon             &double_Hsing_equal  &trans  &trans
&trans  &trans  &Tword_Hshift_2Lock  &kp BACKSPACE  &spc_2shift_Halt  &mt LEFT_GUI TAB  &gui_rclk  &enter_2dash_Halt               &mkp LCLK                           &mt RCTRL ESCAPE     &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        BT_layers {
            bindings = <
&trans  &trans  &trans        &trans        &bt BT_CLR_ALL  &trans        &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &bt BT_SEL 0  &trans        &trans          &trans        &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3    &bt BT_SEL 4  &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans        &bt BT_CLR    &trans          &trans        &bt BT_NXT  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans        &trans        &trans          &trans        &trans      &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        snipe-layers {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings =
                <&scroll_vertical_encoder>,
                // 编码器1：上下滚动,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,
                <&scroll_horizontal_encoder>;

            // 编码器2：左右滚动
        };

        scroll-layers {
            bindings = <
&kp F12  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6          &kp F7              &kp F8            &kp F9         &kp F10  &kp F11
&trans   &trans  &trans  &kp N7  &kp N8  &kp N9  &kp C_PREVIOUS  &kp C_PLAY_PAUSE    &kp C_NEXT        &kp END        &trans   &trans
&trans   &trans  &trans  &kp N4  &kp N5  &kp N6  &kp LEFT        &kp DOWN            &kp UP_ARROW      &kp RIGHT      &trans   &trans
&trans   &trans  &kp N0  &kp N1  &kp N2  &kp N3  &kp RC(LEFT)    &kp RC(DOWN_ARROW)  &kp RC(UP_ARROW)  &kp RC(RIGHT)  &trans   &trans
&trans   &trans  &trans  &trans  &trans  &trans  &trans          &trans              &trans            &trans         &trans   &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp C_AC_HOME END>;
        };

        Symbol-layer {
            bindings = <
&trans  &trans  &kp AT_SIGN     &kp PIPE              &kp DOLLAR        &kp SLASH  &kp LEFT_BRACKET                 &kp RIGHT_BRACKET                  &trans             &trans            &trans  &trans
&trans  &trans  &kp UNDERSCORE  &kp LESS_THAN         &kp GREATER_THAN  &kp CARET  &kp AMPERSAND                    &kp PERCENT                        &kp PIPE           &kp ASTERISK      &none   &none
&trans  &trans  &kp MINUS       &kp HASH              &kp PLUS          &kp EQUAL  &mt LEFT_BRACE LEFT_PARENTHESIS  &mt RIGHT_BRACE RIGHT_PARENTHESIS  &kp DOUBLE_QUOTES  &kp SINGLE_QUOTE  &none   &none
&trans  &trans  &kp TILDE       &kp NON_US_BACKSLASH  &kp SLASH         &kp EXCL   &kp QMARK                        &kp LESS_THAN                      &kp GREATER_THAN   &kp PERIOD        &trans  &none
&trans  &trans  &trans          &trans                &trans            &trans     &trans                           &trans                             &trans             &trans            &trans  &trans
            >;
        };
    };
};
