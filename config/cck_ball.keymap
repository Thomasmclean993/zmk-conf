#define ZMK_POINTING_DEFAULT_MOVE_VAL 1000 // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 12   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <0>;      // 0
    time-to-max-speed-ms = <300>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    // 上下滚动编码器行为

    scroll_vertical_encoder: scroll_vertical_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    // 左右滚动编码器行为

    scroll_horizontal_encoder: scroll_horizontal_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

        tap-ms = <100>;
    };

    behaviors {
    };

    combos {
        compatible = "zmk,combos";

        Delete {
            bindings = <&kp DELETE>;
            key-positions = <27 28>;
        };

        Backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <28 29>;
        };

        Enter {
            bindings = <&kp ENTER>;
            key-positions = <31 32>;
        };

        Left-Click {
            bindings = <&mkp LCLK>;
            key-positions = <30 31>;
        };

        Right-Click {
            bindings = <&mkp RCLK>;
            key-positions = <32 33>;
        };

        Backpage {
            bindings = <&kp K_BACK>;
            key-positions = <26 27>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        QWERTY {
            bindings = <
&lt 1 ESC   &kp N1        &kp N2     &kp N3          &kp N4       &kp N5            &kp N6             &kp N7       &kp N8           &kp N9          &kp N0          &kp BACKSPACE
&kp TAB     &kp Q         &kp W      &mt ESC E       &kp R        &kp T             &kp Y              &kp U        &kp I            &kp O           &kp PERIOD      &kp BSLH
&kp ESC     &kp A         &lt 2 S    &mt LEFT_GUI D  &mt LCTRL F  &mt LEFT_ALT G    &mt RIGHT_ALT H    &mt RCTRL J  &mt RIGHT_GUI K  &kp L           &kp COMMA       &kp SQT
&caps_word  &kp Z         &kp X      &kp C           &kp V        &mt LEFT_SHIFT B  &mt RIGHT_SHIFT N  &kp M        &kp P            &kp COLON       &kp UP_ARROW    &kp FSLH
&kt CAPS    &kp LEFT_WIN  &kp RCTRL  &kp BACKSPACE   &lt 3 SPACE  &kp DELETE        &mkp RCLK          &lt 4 ENTER  &mkp LCLK        &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        BT_layers {
            bindings = <
&trans  &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans      &trans  &trans  &trans  &trans  &kp W
&trans  &trans          &trans        &trans        &trans        &trans        &trans      &trans  &trans  &trans  &trans  &trans
&trans  &bt BT_CLR_ALL  &trans        &trans        &trans        &trans        &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans        &bt BT_CLR    &trans        &trans        &bt BT_NXT  &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans        &trans        &trans        &trans        &trans      &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        snipe-layers {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings =
                <&scroll_vertical_encoder>,
                // 编码器1：上下滚动,,,,,,,,,,,,,,,
                <&scroll_horizontal_encoder>;

            // 编码器2：左右滚动
        };

        scroll-layers {
            bindings = <
&kp F12  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6            &kp F7              &kp F8            &kp F9         &kp F10  &kp F11
&trans   &trans  &trans  &kp N7  &kp N8  &kp N9  &kp C_PLAY_PAUSE  &kp END             &trans            &trans         &trans   &trans
&trans   &trans  &trans  &kp N4  &kp N5  &kp N6  &kp LEFT          &kp DOWN            &kp UP_ARROW      &kp RIGHT      &trans   &trans
&trans   &trans  &kp N0  &kp N1  &kp N2  &kp N3  &kp RC(LEFT)      &kp RC(DOWN_ARROW)  &kp RC(UP_ARROW)  &kp RC(RIGHT)  &trans   &trans
&trans   &trans  &trans  &trans  &trans  &trans  &trans            &trans              &trans            &trans         &trans   &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp C_AC_HOME END>;
        };

        Symbol-layer {
            bindings = <
&trans  &trans  &kp UNDER    &kp PIPE       &kp BACKSLASH     &kp SLASH  &mt SINGLE_QUOTE DOUBLE_QUOTES     &kp AMPERSAND                        &kp ASTRK       &trans           &trans  &trans
&trans  &trans  &kp PERCENT  &kp LESS_THAN  &kp GREATER_THAN  &kp CARET  &mt LEFT_BRACKET LEFT_PARENTHESIS  &mt RIGHT_BRACKET RIGHT_PARENTHESIS  &kp LEFT_BRACE  &kp RIGHT_BRACE  &none   &none
&trans  &trans  &kp MINUS    &kp PLUS       &kp EQUAL         &kp HASH   &kp LEFT_ARROW                     &kp DOWN                             &kp UP_ARROW    &kp RIGHT        &none   &none
&trans  &trans  &kp TILDE    &kp DOLLAR     &kp AT            &kp EXCL   &kp QMARK                          &kp COLON                            &kp COMMA       &kp PERIOD       &trans  &none
&trans  &trans  &trans       &trans         &trans            &trans     &trans                             &trans                               &trans          &trans           &trans  &trans
            >;
        };
    };
};
