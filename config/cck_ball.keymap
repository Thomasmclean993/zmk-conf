#define ZMK_POINTING_DEFAULT_MOVE_VAL 1000 // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 12   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <0>;      // 0
    time-to-max-speed-ms = <300>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    // 上下滚动编码器行为

    scroll_vertical_encoder: scroll_vertical_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    // 左右滚动编码器行为

    scroll_horizontal_encoder: scroll_horizontal_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

        tap-ms = <100>;
    };

    spc_2under_Halt: spc_2under_alt {
        compatible = "zmk,behavior-tap-dance";
        label = "Space to 2t:underscore or h:alt";
        #binding-cells = <0>;
        bindings = <&mt LEFT_ALT SPACE>, <&kp UNDER>;
    };

    period_to_colon: period_to_colon {
        compatible = "zmk,behavior-tap-dance";
        label = "PERIOD_TO_COLON";
        #binding-cells = <0>;
        bindings = <&kp PERIOD>, <&kp COLON>;
    };

    Esc_2caps_shift: Esc_2caps_shift {
        compatible = "zmk,behavior-tap-dance";
        label = "ESC_2CAPS_SHIFT";
        #binding-cells = <0>;
        bindings = <&kp ESC>, <&mt LEFT_SHIFT CAPSLOCK>;
    };

    enter_2dash_Halt: enter_2dash_Halt {
        compatible = "zmk,behavior-tap-dance";
        label = "ENTER_2DASH_HALT";
        #binding-cells = <0>;
        bindings = <&mt RIGHT_ALT ENTER>, <&kp MINUS>;
    };

    back_2del_H3: back_2del_H3 {
        compatible = "zmk,behavior-tap-dance";
        label = "BACK_2DEL_H3";
        #binding-cells = <0>;
        bindings = <&lt 3 BACKSPACE>, <&kp DELETE>;
    };

    gui_rclk: gui_rclk {
        compatible = "zmk,behavior-tap-dance";
        label = "GUI_RCLK";
        #binding-cells = <0>;
        bindings = <&kp RIGHT_GUI>, <&mkp RCLK>;
    };

    behaviors {
    };

    combos {
        compatible = "zmk,combos";

        Left_RCLK {
            bindings = <&mkp RCLK>;
            key-positions = <26 27>;
        };

        Left_LCLK {
            bindings = <&mkp LCLK>;
            key-positions = <28 29>;
        };

        Right_RCLK {
            bindings = <&mkp RCLK>;
            key-positions = <32 33>;
        };

        Right_LCLK {
            bindings = <&mkp LCLK>;
            key-positions = <31 30>;
        };

        Right_Enter {
            bindings = <&kp ENTER>;
            key-positions = <31 32>;
        };

        Left_enter {
            bindings = <&kp ENTER>;
            key-positions = <27 28>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        QWERTY {
            bindings = <
&trans  &trans  &lt 1 DEL         &kp Q          &kp A             &kp Z             &mt LESS_THAN LEFT_PARENTHESIS  &mt GREATER_THAN RIGHT_PARENTHESIS  &mt EXCLAMATION EQUAL  &kp BACKSPACE     &trans  &trans
&trans  &trans  &kp W             &kp E          &kp R             &lt 2 T           &lt 2 Y                         &kp U                               &kp I                  &kp O             &trans  &trans
&trans  &trans  &kp S             &mt LCTRL D    &mt LEFT_GUI F    &lt 4 G           &lt 4 H                         &mt RIGHT_GUI J                     &mt RCTRL K            &kp L             &trans  &trans
&trans  &trans  &kp X             &mt LG(C) C    &mt LG(V) V       &lt 5 B           &lt 5 N                         &kp M                               &period_to_colon       &kp P             &trans  &trans
&trans  &trans  &Esc_2caps_shift  &back_2del_H3  &spc_2under_Halt  &mt LEFT_GUI TAB  &gui_rclk                       &enter_2dash_Halt                   &mkp LCLK              &Esc_2caps_shift  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        BT_layers {
            bindings = <
&trans  &trans  &trans        &trans        &bt BT_CLR_ALL  &trans        &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &bt BT_SEL 0  &trans        &trans          &trans        &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3    &bt BT_SEL 4  &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans        &bt BT_CLR    &trans          &trans        &bt BT_NXT  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans        &trans        &trans          &trans        &trans      &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        snipe-layers {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings =
                <&scroll_vertical_encoder>,
                // 编码器1：上下滚动,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,
                <&scroll_horizontal_encoder>;

            // 编码器2：左右滚动
        };

        scroll-layers {
            bindings = <
&kp F12  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6            &kp F7              &kp F8            &kp F9         &kp F10  &kp F11
&trans   &trans  &trans  &kp N7  &kp N8  &kp N9  &kp C_PLAY_PAUSE  &kp END             &trans            &trans         &trans   &trans
&trans   &trans  &trans  &kp N4  &kp N5  &kp N6  &kp LEFT          &kp DOWN            &kp UP_ARROW      &kp RIGHT      &trans   &trans
&trans   &trans  &kp N0  &kp N1  &kp N2  &kp N3  &kp RC(LEFT)      &kp RC(DOWN_ARROW)  &kp RC(UP_ARROW)  &kp RC(RIGHT)  &trans   &trans
&trans   &trans  &trans  &trans  &trans  &trans  &trans            &trans              &trans            &trans         &trans   &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp C_AC_HOME END>;
        };

        Symbol-layer {
            bindings = <
&trans  &trans  &kp AT_SIGN     &kp PIPE              &kp DOLLAR        &kp SLASH  &kp LEFT_BRACKET                 &kp RIGHT_BRACKET                  &trans             &trans            &trans  &trans
&trans  &trans  &kp UNDERSCORE  &kp LESS_THAN         &kp GREATER_THAN  &kp CARET  &kp AMPERSAND                    &kp PERCENT                        &kp PIPE           &kp ASTERISK      &none   &none
&trans  &trans  &kp MINUS       &kp HASH              &kp PLUS          &kp EQUAL  &mt LEFT_BRACE LEFT_PARENTHESIS  &mt RIGHT_BRACE RIGHT_PARENTHESIS  &kp DOUBLE_QUOTES  &kp SINGLE_QUOTE  &none   &none
&trans  &trans  &kp TILDE       &kp NON_US_BACKSLASH  &kp SLASH         &kp EXCL   &kp QMARK                        &kp LESS_THAN                      &kp GREATER_THAN   &kp PERIOD        &trans  &none
&trans  &trans  &trans          &trans                &trans            &trans     &trans                           &trans                             &trans             &trans            &trans  &trans
            >;
        };

        Num_Ctl_Layer {
            bindings = <
&kp F12  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6            &kp F7              &kp F8            &kp F9         &kp F10  &kp F11
&trans   &trans  &trans  &kp N7  &kp N8  &kp N9  &kp C_PLAY_PAUSE  &kp END             &trans            &trans         &trans   &trans
&trans   &trans  &trans  &kp N4  &kp N5  &kp N6  &kp LEFT          &kp DOWN            &kp UP_ARROW      &kp RIGHT      &trans   &trans
&trans   &trans  &kp N0  &kp N1  &kp N2  &kp N3  &kp RC(LEFT)      &kp RC(DOWN_ARROW)  &kp RC(UP_ARROW)  &kp RC(RIGHT)  &trans   &trans
&trans   &trans  &trans  &trans  &trans  &trans  &trans            &trans              &trans            &trans         &trans   &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp C_AC_HOME END>;
        };
    };
};
